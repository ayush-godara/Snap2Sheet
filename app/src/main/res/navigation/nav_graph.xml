<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/expensesFragment">

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.ayush.snap2sheet.ui.scan.ScanFragment"
        android:label="Scan Receipt"
        tools:layout="@layout/fragment_scan" />

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.ayush.snap2sheet.ui.expenses.ExpensesFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses" />

    <fragment
        android:id="@+id/groupsFragment"
        android:name="com.ayush.snap2sheet.ui.groups.GroupsFragment"
        android:label="Groups"
        tools:layout="@layout/fragment_groups">

        <action
            android:id="@+id/action_groupsFragment_to_groupDetailFragment"
            app:destination="@id/groupDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.ayush.snap2sheet.ui.groups.GroupDetailFragment"
        android:label="Group Detail"
        tools:layout="@layout/fragment_group_detail">

        <action
            android:id="@+id/action_groupDetailFragment_to_addGroupExpenseFragment"
            app:destination="@id/addGroupExpenseFragment" />
    </fragment>

    <fragment
        android:id="@+id/addGroupExpenseFragment"
        android:name="com.ayush.snap2sheet.ui.groups.AddGroupExpenseFragment"
        android:label="Add Group Expense"
        tools:layout="@layout/fragment_add_group_expense" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.ayush.snap2sheet.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ayush.snap2sheet.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
